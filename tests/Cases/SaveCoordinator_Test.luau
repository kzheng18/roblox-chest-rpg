--!strict
return function(t: any)
	local Coordinator = require(game.ServerScriptService.Server.Components.SaveCoordinator)
	local config = {CriticalSaveDebounce = 4, SaveAttemptTimeout = 15, SaveRetryMaxSeconds = 30}
	local function fixture()
		local at = 0
		local q = Coordinator.new(0, config, function() return at end)
		return q, function(delta: number) at += delta end
	end
	t.test("continuous purchases cannot postpone the first checkpoint", function()
		local q, advance = fixture()
		for revision = 1, 4 do q.Dirty(revision); q.Request(); advance(1) end
		t.expect.truthy(q.Step(true)); t.expect.equal(q.Status(), "Saving")
	end)
	t.test("stale acknowledgement never claims newer inventory was saved", function()
		local q = fixture()
		q.Dirty(1); q.Begin(); q.Dirty(2); q.Acknowledge(1)
		t.expect.equal(q.Status(), "Pending"); t.expect.equal(q.SavedRevision(), 1)
		q.Begin(); q.Acknowledge(2); t.expect.equal(q.Status(), "Saved")
		q.Acknowledge(0); t.expect.equal(q.SavedRevision(), 2)
	end)
	t.test("new critical rewards during a save retain their checkpoint", function()
		local q, advance = fixture()
		q.Dirty(1); q.Begin(); q.Dirty(2); q.Request(); q.Acknowledge(1)
		advance(4); t.expect.truthy(q.Step(true)); q.Acknowledge(2)
		t.expect.equal(q.Status(), "Saved")
	end)
	t.test("save timeout retries with bounded backoff and recovers", function()
		local q, advance = fixture()
		q.Dirty(1); q.Request(); advance(4); t.expect.truthy(q.Step(true))
		advance(15); t.expect.falsy(q.Step(true)); t.expect.equal(q.Status(), "Delayed")
		q.Dirty(2); q.Request(); t.expect.equal(q.Status(), "Delayed")
		advance(2); t.expect.truthy(q.Step(true)); q.Acknowledge(2)
		t.expect.equal(q.Status(), "Saved")
	end)
	t.test("no write budget delays safely without claiming saved", function()
		local q, advance = fixture()
		q.Dirty(1); q.Request(); advance(4)
		for _ = 1, 100 do t.expect.falsy(q.Step(false)) end
		t.expect.equal(q.Status(), "Delayed"); t.expect.equal(q.SavedRevision(), 0)
		t.expect.truthy(q.Step(true))
	end)
	t.test("departed session ignores late saves and queued checkpoints", function()
		local q, advance = fixture()
		q.Dirty(1); q.Request(); q.Detach(); advance(60)
		t.expect.falsy(q.Step(true)); q.Acknowledge(1); t.expect.equal(q.SavedRevision(), 0)
	end)
	t.test("future acknowledgement cannot mark unsaved state durable", function()
		local q = fixture()
		q.Dirty(1); q.Begin(); q.Acknowledge(999)
		t.expect.equal(q.Status(), "Saving"); t.expect.equal(q.SavedRevision(), 0)
	end)
end
